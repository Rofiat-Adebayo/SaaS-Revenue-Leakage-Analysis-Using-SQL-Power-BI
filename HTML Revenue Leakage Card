HTML Revenue Leakage Card = 
VAR _total = [Total Potential Revenue Leekage]
VAR _under = [Total Under billing]
VAR _discount = [Excessive Discount Amount]
VAR _overdue = [Missed Payment Amount]
VAR _momPctRaw = [MoM % Change]
VAR _momValue = [Mom Potential leekage change]

VAR _totalFmt = FORMAT(_total, "£#,##0")
VAR _underFmt = FORMAT(_under, "£#,##0")
VAR _discountFmt = FORMAT(_discount, "£#,##0")
VAR _overdueFmt = FORMAT(_overdue, "£#,##0")
VAR _momPct = IF(ISBLANK(_momPctRaw), "—", _momPctRaw)

VAR _momColor =
    IF(
        CONTAINSSTRING(_momPct, "↗")
            || CONTAINSSTRING(_momPct, "▲"),
        "#FF5C5C",
        IF(
            CONTAINSSTRING(_momPct, "↘")
                || CONTAINSSTRING(_momPct, "▼"),
            "#A3E635",
            "#C4B5FD"
        )
    )

VAR _momValueFmt =
    IF(
        ISBLANK(_momValue),
        "Not available",
        IF(
            _momValue > 0,
            "↗ £" & FORMAT(ABS(_momValue), "#,##0"),
            IF(
                _momValue < 0,
                "↘ £" & FORMAT(ABS(_momValue), "#,##0"),
                "→ £0"
            )
        )
    )

VAR _momValueColor =
    IF(
        ISBLANK(_momValue),
        "#C4B5FD",
        IF(
            _momValue > 0,
            "#FF5C5C",
            IF(
                _momValue < 0,
                "#A3E635",
                "#C4B5FD"
            )
        )
    )

VAR _momInsight =
    IF(
        ISBLANK(_momValue),
        "A previous-month comparison is not available for the current selection. Choose a period with a valid previous month to compare.",
        IF(
            _momValue > 0,
            "Potential revenue leakage increased compared with the previous month. Review the billing, discount and payment trends to understand what drove the movement.",
            IF(
                _momValue < 0,
                "Potential revenue leakage decreased compared with the previous month. Continue monitoring the billing, discount and payment trends to see whether the improvement continues.",
                "Potential revenue leakage was unchanged compared with the previous month. Review the category trends to check whether the underlying drivers also remained stable."
            )
        )
    )

VAR _underWidth =
    FORMAT(
        MAX(0, MIN(100, DIVIDE(_under, _total, 0) * 100)),
        "0.0"
    ) & "%"

VAR _discountWidth =
    FORMAT(
        MAX(0, MIN(100, DIVIDE(_discount, _total, 0) * 100)),
        "0.0"
    ) & "%"

VAR _overdueWidth =
    FORMAT(
        MAX(0, MIN(100, DIVIDE(_overdue, _total, 0) * 100)),
        "0.0"
    ) & "%"

VAR _underPct = FORMAT(DIVIDE(_under, _total, 0), "0.0%")
VAR _discountPct = FORMAT(DIVIDE(_discount, _total, 0), "0.0%")
VAR _overduePct = FORMAT(DIVIDE(_overdue, _total, 0), "0.0%")

RETURN
    "<style>" &
    "*{box-sizing:border-box;margin:0;padding:0;font-family:Segoe UI,Calibri,Arial,sans-serif}" &
    ".stage{width:100%;height:100%;min-height:0;padding:0;color:#FFFFFF;overflow:hidden;font-family:Segoe UI,Calibri,Arial,sans-serif}" &
    ".viewport{position:relative;width:100%;height:100%;min-height:0;overflow:hidden;border-radius:14px}" &
    ".slides{display:flex;width:200%;height:100%;min-height:0;transition:transform .55s cubic-bezier(.22,.75,.25,1);will-change:transform}" &
    ".viewport:hover .slides{transform:translateX(-50%)}" &
    ".face{flex:0 0 50%;width:50%;height:100%;min-height:0;display:flex;flex-direction:column;gap:9px;padding:12px;border-radius:14px;overflow:hidden;background:linear-gradient(145deg,#1B1C21 0%,#14151A 100%)}" &
    ".hero-head{display:flex;align-items:center;gap:8px;min-width:0}" &
    ".hero-icon{width:29px;height:29px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:#292833;color:#C4B5FD;font-size:17px;flex-shrink:0}" &
    ".eyebrow{font-size:13px;font-weight:700;line-height:1.3;color:#F0EEF8;letter-spacing:.15px;overflow-wrap:anywhere}" &
    ".hero-row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:10px;margin-bottom:4px;min-width:0}" &
    ".hero-copy{flex:1;min-width:0}" &
    ".hero-value{font-size:38px;line-height:1.05;font-weight:750;letter-spacing:-.4px;color:#FFFFFF;white-space:nowrap}" &
    ".hero-note{font-size:13px;line-height:1.35;color:#D4D4DE;margin-top:6px}" &
    ".mom-pill{flex:0 0 auto;min-width:88px;max-width:43%;padding:6px 7px;border-radius:8px;background:#292833;text-align:center}" &
    ".mom-value{font-size:20px;line-height:1.15;font-weight:750;color:" & _momColor & ";white-space:normal;overflow-wrap:anywhere}" &
    ".mom-label{font-size:11px;line-height:1.25;color:#E0E0E7;margin-top:3px}" &
    ".divider{height:1px;background:#34343D;width:100%;flex-shrink:0;margin-top:2px;margin-bottom:2px}" &
    ".section-title{font-size:12px;line-height:1.3;font-weight:750;letter-spacing:.4px;color:#E5E2EE;text-transform:uppercase;margin-top:2px;margin-bottom:3px}" &
    ".category-list{display:flex;flex-direction:column;gap:9px;min-height:0}" &
    ".category{display:grid;grid-template-columns:28px minmax(0,1fr);gap:9px;align-items:center;padding:9px 10px;border-radius:10px;background:#292833}" &
    ".cat-icon{width:26px;height:26px;border-radius:7px;background:#302742;color:#C4B5FD;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0}" &
    ".cat-icon.blue{background:#25283A;color:#A78BFA}" &
    ".cat-icon.lilac{background:#302B42;color:#C4B5FD}" &
    ".cat-content{min-width:0}" &
    ".cat-top{display:flex;align-items:center;justify-content:space-between;gap:8px;min-width:0}" &
    ".cat-label{font-size:13px;line-height:1.25;color:#F0EEF8;min-width:0;overflow-wrap:anywhere}" &
    ".cat-amount{font-size:15px;line-height:1.2;font-weight:750;color:#FFFFFF;white-space:nowrap;flex-shrink:0}" &
    ".bar-row{display:flex;align-items:center;gap:9px;margin-top:7px;min-width:0}" &
    ".track{height:9px;flex:1;min-width:0;background:#0D0E12;border-radius:99px;overflow:hidden}" &
    ".fill{height:100%;border-radius:99px;min-width:3px}" &
    ".bar-pct{font-size:12px;line-height:1.2;color:#F0EEF8;width:38px;text-align:right;flex-shrink:0;font-weight:600}" &
    ".hint{font-size:10px;line-height:1.25;color:#D4D4DE;text-align:right;margin-top:auto;padding-top:4px}" &
    ".back-top{display:flex;align-items:center;justify-content:space-between;gap:10px}" &
    ".back-tag{font-size:12px;line-height:1.3;letter-spacing:.5px;text-transform:uppercase;color:#C4B5FD;font-weight:750}" &
    ".back-title{font-size:26px;line-height:1.25;font-weight:750;color:#FFFFFF;margin-top:12px;overflow-wrap:anywhere}" &
    ".back-label{font-size:13px;line-height:1.35;color:#E0E0E7;margin-top:10px}" &
    ".back-value{font-size:36px;line-height:1.05;font-weight:750;color:" & _momValueColor & ";margin-top:4px;overflow-wrap:anywhere}" &
    ".back-customer{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 11px;border-radius:8px;background:#292833;margin-top:11px}" &
    ".customer-label{font-size:13px;line-height:1.25;color:#E0E0E7}" &
    ".customer-value{font-size:16px;line-height:1.2;font-weight:750;color:#FFFFFF;white-space:nowrap}" &
    ".insight-panel{margin-top:auto;padding:12px;border-radius:10px;background:#202029}" &
    ".insight-title{font-size:12px;line-height:1.25;font-weight:750;letter-spacing:.4px;color:#C4B5FD;text-transform:uppercase;margin-bottom:8px}" &
    ".back-body{font-size:14px;line-height:1.4;color:#F5F4F8;overflow-wrap:anywhere}" &
    ".back-foot{font-size:10px;line-height:1.25;color:#D4D4DE;text-align:right;margin-top:6px}" &
    ".viewport, .viewport:hover, .viewport:focus, .viewport:focus-visible, .slides, .slides:hover, .face, .face:hover {border:none !important;outline:none !important;}" &
    "</style>" &

    "<div class='stage'><div class='viewport'><div class='slides'>" &

    "<div class='face front'>" &

        "<div>" &
            "<div class='hero-head'><div class='hero-icon'>▥</div><div class='eyebrow'>TOTAL POTENTIAL REVENUE LEAKAGE</div></div>" &
            "<div class='hero-row'><div class='hero-copy'><div class='hero-value'>" & _totalFmt & "</div><div class='hero-note'>Potential financial exposure</div></div>" &
                "<div class='mom-pill'><div class='mom-value'>" & _momPct & "</div><div class='mom-label'>vs. previous month</div></div>" &
            "</div>" &
        "</div>" &

        "<div class='divider'></div>" &

        "<div class='section-title'>Revenue Leakage Breakdown</div>" &

        "<div class='category-list'>" &

            "<div class='category'><div class='cat-icon'>◈</div><div class='cat-content'><div class='cat-top'><span class='cat-label'>Overdue payments</span><span class='cat-amount'>" & _overdueFmt & "</span></div><div class='bar-row'><div class='track'><div class='fill' style='width:" & _overdueWidth & ";background:#8B5CF6'></div></div><span class='bar-pct'>" & _overduePct & "</span></div></div></div>" &

            "<div class='category'><div class='cat-icon blue'>▤</div><div class='cat-content'><div class='cat-top'><span class='cat-label'>Under-billing</span><span class='cat-amount'>" & _underFmt & "</span></div><div class='bar-row'><div class='track'><div class='fill' style='width:" & _underWidth & ";background:#A78BFA'></div></div><span class='bar-pct'>" & _underPct & "</span></div></div></div>" &

            "<div class='category'><div class='cat-icon lilac'>%</div><div class='cat-content'><div class='cat-top'><span class='cat-label'>Excessive discounts</span><span class='cat-amount'>" & _discountFmt & "</span></div><div class='bar-row'><div class='track'><div class='fill' style='width:" & _discountWidth & ";background:#C4B5FD'></div></div><span class='bar-pct'>" & _discountPct & "</span></div></div></div>" &

        "</div>" &

        "<div class='hint'>Hover to slide to monthly insights →</div>" &

    "</div>" &

    "<div class='face back'>" &

        "<div>" &
            "<div class='back-top'><div class='back-tag'>Month-over-month insight</div><div class='hero-icon'>↗</div></div>" &
            "<div class='back-title'>How potential leakage changed</div>" &
            "<div class='back-label'>Value change vs. previous month</div>" &
            "<div class='back-value'>" & _momValueFmt & "</div>" &
            "<div class='back-customer'><span class='customer-label'>Customers affected</span><span class='customer-value'>7 customers</span></div>" &
        "</div>" &

        "<div class='insight-panel'><div class='insight-title'>Summary insight</div><div class='back-body'>" & _momInsight & "</div></div>" &

        "<div class='back-foot'>Move your pointer away to return to the overview</div>" &

    "</div>" &

    "</div></div></div>"
